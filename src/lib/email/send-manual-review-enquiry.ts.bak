import {
  getResendClient,
} from "@/lib/email/resend";


function escapeHtml(
  value: string
) {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}


export async function sendManualReviewEnquiryEmail(
  input: {
    clientName: string;
    clientEmail: string;
    sourceLanguage: string;
    targetLanguage: string;
    documentType: string;
    purpose: string;
    turnaround: string;
    enquiryId: string;
  }
) {
  const adminEmail =
    process.env
      .ADMIN_NOTIFICATION_EMAIL
      ?.trim();


  if (!adminEmail) {
    console.warn(
      "ADMIN_NOTIFICATION_EMAIL is not configured."
    );

    return;
  }


  const appUrl =
    process.env.NEXT_PUBLIC_APP_URL ||
    "http://localhost:3000";


  const enquiryUrl =
    `${appUrl}/admin/enquiries/${input.enquiryId}`;


  const resend =
    getResendClient();


  const from =
    process.env.EMAIL_FROM ||
    "GLOBAL TRANSLATION HUB <orders@send.globaltranslationhub.co.uk>";


  const {
    error,
  } =
    await resend.emails.send({
      from,

      to:
        adminEmail,

      subject:
        `New Manual Review Enquiry - ${input.sourceLanguage} → ${input.targetLanguage}`,

      html: `
        <div style="font-family:Arial,sans-serif;color:#13201a;line-height:1.6">
          <h2>GLOBAL TRANSLATION HUB</h2>

          <h3>New Manual Review Enquiry</h3>

          <p>
            A new translation enquiry requires manual review.
          </p>

          <p>
            <strong>Client:</strong>
            ${escapeHtml(input.clientName)}
            <br />

            <strong>Email:</strong>
            ${escapeHtml(input.clientEmail)}
            <br />

            <strong>Document:</strong>
            ${escapeHtml(input.documentType)}
            <br />

            <strong>Language:</strong>
            ${escapeHtml(input.sourceLanguage)}
            →
            ${escapeHtml(input.targetLanguage)}
            <br />

            <strong>Purpose:</strong>
            ${escapeHtml(input.purpose)}
            <br />

            <strong>Turnaround:</strong>
            ${escapeHtml(input.turnaround)}
          </p>

          <p>
            <a href="${enquiryUrl}">
              Review Enquiry
            </a>
          </p>

          <p>
            GLOBAL TRANSLATION HUB
          </p>
        </div>
      `,
    });


  if (error) {
    throw new Error(
      "Unable to send manual review notification."
    );
  }
}